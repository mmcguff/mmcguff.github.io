---
import BlogHeader from '../components/BlogHeader.astro';
import Comments from '../components/Comments.astro';
import { SITE_TITLE } from '../consts';
import type { BlogFrontmatter } from '../content/schema';
import BaseLayout from './BaseLayout.astro';

type Props = BlogFrontmatter;

const { title, description, pubDate, updatedDate, draft } = Astro.props;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${title} | ${SITE_TITLE}`} description={description}>
  <BlogHeader title="Blog" />
  <main class="section">
    <article class="container is-max-desktop">
      <header class="post-header">
        <h1 class="title is-2">{title}</h1>
        <p class="subtitle is-6">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                {' · Updated '}
                <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
      </header>
      <div class="content">
        <slot />
      </div>
    </article>
    {
      /* Drafts only render in dev; a comment there would open a public Discussion. */
      !draft && (
        <div class="container is-max-desktop">
          <Comments />
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }
  .content {
    overflow-wrap: anywhere;
  }
  .content :global(pre) {
    overflow-x: auto;
    max-width: 100%;
  }
  .content :global(img) {
    max-width: 100%;
    height: auto;
  }
  .comments {
    padding-left: 0;
    padding-right: 0;
  }
</style>
