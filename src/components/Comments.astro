---
import { GISCUS } from '../consts';
---

<section class="section comments" aria-label="Comments">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={GISCUS.repo}
    data-repo-id={GISCUS.repoId}
    data-category={GISCUS.category}
    data-category-id={GISCUS.categoryId}
    data-mapping={GISCUS.mapping}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="light"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
  <script is:inline>
    // Giscus reads data-theme when its client runs, so set it from the site theme (not the device) first.
    document.currentScript.previousElementSibling.dataset.theme = document.documentElement.dataset.theme;
  </script>
</section>
