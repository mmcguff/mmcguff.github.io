---
// A toggle button: the label stays "Dark mode" and aria-pressed carries the state (the standard toggle-button pattern).
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
  <span class="theme-toggle-icon" aria-hidden="true"></span>
</button>

<script>
  import { GISCUS_ORIGIN, THEME_STORAGE_KEY, type Theme } from '../lib/theme';

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const currentTheme = (): Theme => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  function renderState() {
    const pressed = String(currentTheme() === 'dark');
    buttons.forEach((button) => button.setAttribute('aria-pressed', pressed));
  }

  /** Giscus lives in a cross-origin iframe, so a message is the only way to change its theme live. */
  function syncGiscus(theme: Theme) {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, GISCUS_ORIGIN);
  }

  function setTheme(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {
      // Storage blocked: the choice still applies to this page, it just won't be remembered.
    }
    renderState();
    syncGiscus(theme);
  }

  buttons.forEach((button) =>
    button.addEventListener('click', () => setTheme(currentTheme() === 'dark' ? 'light' : 'dark')),
  );
  renderState();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #fff;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }
  /* Moon while light (press to go dark), sun while dark. */
  .theme-toggle-icon::before {
    content: '\1F319';
  }
  :global(html[data-theme='dark']) .theme-toggle-icon::before {
    content: '\2600\FE0F';
  }
</style>
